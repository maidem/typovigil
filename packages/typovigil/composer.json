{
    "name": "maidemde/typovigil",
    "type": "typo3-cms-extension",
    "description": "Central dashboard for TYPO3 update and security monitoring. Receives reports from typovigil_agent instances and matches them against the official TYPO3 and Packagist security sources.",
    "homepage": "https://maidem.de",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3 CMS",
        "security",
        "monitoring",
        "updates"
    ],
    "authors": [
        {
            "name": "Maik Demuth",
            "email": "hi@maidem.de",
            "homepage": "https://maidem.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "typo3/cms-core": "^14.0",
        "typo3/cms-backend": "^14.0",
        "typo3/cms-extbase": "^14.0",
        "typo3/cms-fluid": "^14.0",
        "typo3/cms-scheduler": "^14.0"
    },
    "autoload": {
        "psr-4": {
            "Maidemde\\Typovigil\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "typovigil"
        }
    }
}
