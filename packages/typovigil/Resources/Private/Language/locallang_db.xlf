    <file source-language="en" datatype="plaintext" original="messages" date="2026-09-13T00:00:00Z" product-name="typovigil">
        <header/>
        <body>
            <trans-unit id="tx_typovigil_project">
                <source>Monitored project</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.title">
                <source>Title</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.site_url">
                <source>Site URL</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.site_url.description">
                <source>Base address of the monitored TYPO3 backend, e.g. https://example.com. Used to build the one-click setup link for the agent extension.</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.token_hash">
                <source>Token (hash)</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.token_hash.description">
                <source>Only the hash is stored. The token itself is shown once when the project is created and cannot be recovered afterwards.</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.core_version">
                <source>TYPO3 version</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.last_report_at">
                <source>Last report</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.coolify_application_uuid">
                <source>Hosting platform application UUID</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.coolify_application_uuid.description">
                <source>UUID of the application on the hosting platform, from its detail page URL. Leave empty for a project that is not hosted there — it stays plain monitoring.</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.coolify_storage_uuid">
                <source>Hosting platform storage backup schedule UUID</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.coolify_storage_uuid.description">
                <source>UUID of the application's volume backup schedule (Persistent Storage → Backups). Required to trigger a storage backup before an update.</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.coolify_database_uuid">
                <source>Hosting platform database UUID</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.coolify_database_uuid.description">
                <source>UUID of the database resource on the hosting platform that belongs to this application.</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.coolify_db_scheduled_backup_uuid">
                <source>Hosting platform database backup schedule UUID</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.coolify_db_scheduled_backup_uuid.description">
                <source>UUID of the database's scheduled backup configuration. Used to check whether the last automatic backup is recent enough — the hosting platform has no on-demand database backup endpoint.</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.last_backup_at">
                <source>Last backup check</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.last_backup_status">
                <source>Last backup status</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.fe_users">
                <source>Visible to frontend users</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.fe_users.description">
                <source>These users can see this project's status in the frontend. Without an assignment nobody sees it.</source>
            </trans-unit>
            <trans-unit id="fe_users.tx_typovigil_projects">
                <source>Assigned projects</source>
            </trans-unit>
            <trans-unit id="fe_users.tx_typovigil_projects.description">
                <source>The projects this customer can see in the frontend. This is the same assignment as on the project's own access tab, seen from the other side.</source>
            </trans-unit>
            <trans-unit id="fe_users.tab.typovigil">
                <source>TypoVigil</source>
            </trans-unit>
            <trans-unit id="tx_typovigil_project.notes">
                <source>Notes</source>
            </trans-unit>
            <trans-unit id="tab.general">
                <source>General</source>
            </trans-unit>
            <trans-unit id="tab.status">
                <source>Status</source>
            </trans-unit>
            <trans-unit id="tab.access">
                <source>Access</source>
            </trans-unit>
            <trans-unit id="tab.coolify">
                <source>Hosting platform</source>
            </trans-unit>
            <trans-unit id="task.updateCheck.title">
                <source>TypoVigil: check for updates</source>
            </trans-unit>
            <trans-unit id="task.updateCheck.description">
                <source>Matches all reported packages against Packagist, get.typo3.org and the security advisories.</source>
            </trans-unit>
        </body>
    </file>
</xliff>
